# MrExchange Panel — environment template.
# Copy to .env (local) or .env.docker (compose) and fill in real values.
#
# WARNING: settings.py ships a working fallback for DJANGO_SECRET_KEY. That
# literal is in git history and must be treated as compromised — rotate it and
# set the variable below on every deployed host.

# ---- Delivery mode ----
# cloud = hosted multi-user SaaS; customer_server = dedicated installation.
DEPLOYMENT_MODE=cloud

# ---- Core Django ----
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=change-me
# Defaults to True in settings.py. Always set this explicitly in production.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=mrexchange.co.uk,www.mrexchange.co.uk
DJANGO_CSRF_TRUSTED_ORIGINS=https://mrexchange.co.uk,https://www.mrexchange.co.uk
# true only behind a plain-HTTP reverse proxy (e.g. *.traefik.me previews)
DJANGO_USE_HTTP_BEHIND_PROXY=false
DJANGO_USE_X_FORWARDED_HOST=false

# ---- Database ----
SQLITE_PATH=/app/backend/data/db.sqlite3
SQLITE_TIMEOUT=30

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=90
CELERY_RESULT_EXPIRES=3600
FINALIZE_TASK_WAIT_TIMEOUT=75

# ---- Trial policy ----
INDIVIDUAL_TRIAL_DAYS=14

# --- Self-serve signup -------------------------------------------------------
# Registration open to anyone with an email address. Turn off to make the panel
# invite-only again; the login page and the programmer hub are unaffected.
SIGNUP_ENABLED=true
# Sends the confirmation email. Access is granted before it is confirmed either
# way, so turning this off only removes the mail and the banner's resend button.
SIGNUP_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_TIMEOUT=259200
# Absolute base for links inside outgoing mail, e.g. https://panel.mrexchange.co.uk
PUBLIC_BASE_URL=

# --- Outgoing email ----------------------------------------------------------
# Leave EMAIL_HOST empty to print mail to the console instead of sending it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=MrExchange <no-reply@mrexchange.co.uk>
TRIAL_EXPIRY_CHECK_SECONDS=3600
# Warn this many days before expiry, once per trial.
TRIAL_REMINDER_DAYS=3
TRIAL_REMINDER_CHECK_SECONDS=3600
# After expiry the panel is already blocked; the stack and its data survive
# this many more days so a late conversion still finds them.
TRIAL_GRACE_DAYS=7
TRIAL_TEARDOWN_CHECK_SECONDS=86400

# ---- Trial provisioning (set only on the VPS that hosts trial stacks) ----
# One isolated compose stack per trial signup. Off everywhere else, so a
# developer machine or a customer server never shells out to Docker.
TRIAL_PROVISIONING_ENABLED=false
TRIAL_BASE_DOMAIN=mrexchange.co.uk
TRIAL_STACKS_ROOT=/srv/mrexchange/trials
TRIAL_ARCHIVE_ROOT=/srv/mrexchange/trial-archives
TRIAL_IMAGE=mrexchange/panel:latest
TRIAL_CERT_RESOLVER=letsencrypt
TRIAL_EDGE_NETWORK=edge
TRIAL_ADMIN_USERNAME=admin
DOCKER_COMPOSE_COMMAND=docker compose

# ---- Fleet check-in (set on every deployed install) ----
# The daily heartbeat sends the license key, app version and uptime — never
# prices, customers or credentials. Leave FLEET_LICENSE_KEY empty to stay dark.
FLEET_CHECKIN_URL=https://mrexchange.co.uk/api/fleet/checkin/
FLEET_LICENSE_KEY=
FLEET_CHECKIN_SECONDS=86400
APP_VERSION=
# Default term when a license is issued or reissued without an explicit date.
LICENSE_TERM_DAYS=365

# ---- Bootstrap accounts ----
# Do NOT ship admin/admin. Set a real password and leave SYNC off after first boot,
# otherwise every container restart resets the password back to this value.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me
DEFAULT_ADMIN_SYNC_PASSWORD=false

# ---- Public demo account ----
# POST /api/auth/demo-login/ signs anyone in as this user with NO password.
# The demo account has role=management, so it can write prices and publish to the
# Telegram/Instagram accounts configured on this host. Only enable it on a host whose
# integrations point at throwaway channels.
DEMO_LOGIN_ENABLED=True
DEMO_USERNAME=demo


# ---- Instagram Hub (optional) ----
# Public base URL Meta can fetch rendered images from.
INSTAGRAM_BASE_URL=

# ---- Misc ----
FINALIZE_STRICT_TELEGRAM=False
ANALYTICS_MAX_RANGE_DAYS=366
