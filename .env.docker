# MrExchange Panel — local testing config

# ---- Core Django ----
DJANGO_SECRET_KEY=local-testing-key-not-for-production-use
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:18000,http://127.0.0.1:18000
DJANGO_USE_HTTP_BEHIND_PROXY=false
DJANGO_USE_X_FORWARDED_HOST=false

# ---- Database ----
SQLITE_PATH=/app/backend/data/db.sqlite3
SQLITE_TIMEOUT=30

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=90
CELERY_RESULT_EXPIRES=3600
FINALIZE_TASK_WAIT_TIMEOUT=75

# ---- Bootstrap accounts ----
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_SYNC_PASSWORD=true

# ---- Public demo account ----
DEMO_LOGIN_ENABLED=True
DEMO_USERNAME=demo


# ---- Instagram Hub (optional) ----
INSTAGRAM_BASE_URL=

# ---- Misc ----
FINALIZE_STRICT_TELEGRAM=False
ANALYTICS_MAX_RANGE_DAYS=366