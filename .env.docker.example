DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
# Required for Dokploy *.traefik.me (HTTP-only preview). Remove or set false on real HTTPS domains.
DJANGO_USE_HTTP_BEHIND_PROXY=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,smartexchange-application-o0bso2-3d625a-204-168-142-183.traefik.me
DJANGO_CSRF_TRUSTED_ORIGINS=http://smartexchange-application-o0bso2-3d625a-204-168-142-183.traefik.me
FINALIZE_STRICT_TELEGRAM=False
INSTAGRAM_BASE_URL=http://smartexchange-application-o0bso2-3d625a-204-168-142-183.traefik.me
EXTERNAL_API_URL=https://sarafipardis.co.uk/wp-json/pardis/v1/rates
EXTERNAL_API_KEY=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2
BOT_GATEWAY_RATES_CACHE_TTL=15
BOT_GATEWAY_FRONTEND_URL=http://localhost:5250
BOT_CUSTOMER_JWT_LIFETIME_MINUTES=60
BOT_GATEWAY_RATE_LIMIT=20
BOT_GATEWAY_RATE_WINDOW=60
CELERY_TASK_TIME_LIMIT=120
CELERY_TASK_SOFT_TIME_LIMIT=90
FINALIZE_TASK_WAIT_TIMEOUT=75

# Headless Playwright template screenshots (Telegram boards)
# Docker Celery worker should use http://app:5173; local dev http://localhost:5250
PLAYWRIGHT_FRONTEND_BASE_URL=http://localhost:5250
PLAYWRIGHT_SCREENSHOT_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_CONCURRENT=2
SCREENSHOT_CACHE_TTL=300

# Optional: default admin seed (see ensure_default_admin command)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
# Dev Docker: reset password on container start so admin/admin always works. Use false in production.
DEFAULT_ADMIN_SYNC_PASSWORD=true
